{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/NomaDamas/Kechap/catalog/provider.schema.json",
  "title": "Kechap provider discovery and evidence registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "researchDate",
    "evidenceStatus",
    "evidenceNote",
    "providers"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "researchDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "evidenceStatus": {
      "type": "string",
      "minLength": 1
    },
    "evidenceNote": {
      "type": "string",
      "minLength": 1
    },
    "providers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/provider"
      }
    }
  },
  "definitions": {
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "kind",
        "assurance",
        "sourceUrl",
        "docsUrl",
        "license",
        "stars",
        "starsCheckedAt",
        "over10k",
        "deployment",
        "modalities",
        "privacy",
        "accessibility",
        "adapterStatus",
        "sourceStatus",
        "notes",
        "productionReady"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "commercial",
            "experimental",
            "license-unconfirmed",
            "mixed-source",
            "open-source",
            "source-available",
            "standard"
          ]
        },
        "assurance": {
          "enum": [
            "account-continuity",
            "automation-cost",
            "bot-mitigation",
            "device-continuity",
            "group-membership",
            "interaction",
            "liveness",
            "personhood",
            "identity",
            "uniqueness",
            "research-signal"
          ]
        },
        "sourceUrl": {
          "type": "string",
          "pattern": "^https://[^\\s]+$"
        },
        "docsUrl": {
          "type": "string",
          "pattern": "^https://[^\\s]+$"
        },
        "license": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "spdx",
            "status"
          ],
          "properties": {
            "spdx": {
              "type": "string",
              "minLength": 1
            },
            "status": {
              "enum": [
                "candidate-not-audited",
                "source-inspected",
                "not-found",
                "not-applicable",
                "approved"
              ]
            },
            "evidenceUrl": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^https://[^\\s]+$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "note": {
              "type": "string"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "status": {
                    "enum": [
                      "source-inspected",
                      "approved"
                    ]
                  }
                }
              },
              "then": {
                "required": [
                  "evidenceUrl"
                ],
                "properties": {
                  "evidenceUrl": {
                    "type": "string",
                    "pattern": "^https://[^\\s]+$"
                  },
                  "spdx": {
                    "not": {
                      "enum": [
                        "unknown",
                        "NOASSERTION"
                      ]
                    }
                  }
                }
              }
            }
          ]
        },
        "stars": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "starsCheckedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "over10k": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "deployment": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "modalities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "privacy": {
          "type": "string",
          "minLength": 1
        },
        "accessibility": {
          "type": "string",
          "minLength": 1
        },
        "adapterStatus": {
          "enum": [
            "planned",
            "implemented-mock-tested-live-unverified",
            "implemented-upstream-and-browser-tested"
          ]
        },
        "sourceStatus": {
          "enum": [
            "not-fetched",
            "official-document-fetched",
            "source-reviewed"
          ]
        },
        "notes": {
          "type": "string"
        },
        "upstreamRevision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "archived": {
          "type": "boolean"
        },
        "pushedAt": {
          "type": "string",
          "minLength": 1
        },
        "evidenceFile": {
          "type": "string",
          "pattern": "^catalog/evidence/[A-Za-z0-9_.-]+\\.json$"
        },
        "productionReady": {
          "type": "boolean"
        },
        "adoptionEvidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "type": "string",
              "minLength": 1
            },
            "notes": {
              "type": "string",
              "minLength": 1
            },
            "sourceUrl": {
              "type": "string",
              "pattern": "^https://[^\\s]+$"
            },
            "claim": {
              "type": "string",
              "minLength": 1
            }
          },
          "anyOf": [
            {
              "required": [
                "notes"
              ]
            },
            {
              "required": [
                "sourceUrl",
                "claim"
              ]
            }
          ]
        },
        "recommendationStatus": {
          "enum": [
            "baseline-only",
            "candidate-source-reviewed",
            "commercial-license-review-required",
            "not-recommended-maintenance"
          ]
        },
        "downloadMetric": {
          "type": "object",
          "required": [
            "downloads",
            "start",
            "end",
            "package",
            "fetchedAt",
            "evidenceFile",
            "meaning"
          ],
          "additionalProperties": false,
          "properties": {
            "downloads": {
              "type": "integer",
              "minimum": 0
            },
            "start": {
              "type": "string",
              "minLength": 1
            },
            "end": {
              "type": "string",
              "minLength": 1
            },
            "package": {
              "type": "string",
              "minLength": 1
            },
            "fetchedAt": {
              "type": "string",
              "minLength": 1
            },
            "evidenceFile": {
              "type": "string",
              "pattern": "^catalog/evidence/[A-Za-z0-9_.-]+\\.json$"
            },
            "meaning": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "implementedAssurance": {
          "enum": [
            "automation-cost",
            "bot-mitigation",
            "interaction",
            "liveness",
            "identity",
            "uniqueness"
          ]
        },
        "implementedProtocol": {
          "type": "string",
          "minLength": 1
        },
        "sourceCheckedAt": {
          "type": "string",
          "minLength": 1
        },
        "sourceEvidenceNote": {
          "type": "string",
          "minLength": 1
        },
        "approval": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "maintainer",
            "securityReview",
            "accessibilityReview",
            "licenseReview",
            "approvedAt",
            "revision"
          ],
          "properties": {
            "maintainer": {
              "type": "string",
              "minLength": 1
            },
            "securityReview": {
              "type": "string",
              "pattern": "^https://[^\\s]+$"
            },
            "accessibilityReview": {
              "type": "string",
              "pattern": "^https://[^\\s]+$"
            },
            "licenseReview": {
              "type": "string",
              "pattern": "^https://[^\\s]+$"
            },
            "approvedAt": {
              "type": "string",
              "minLength": 1
            },
            "revision": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "sourceStatus": {
                "const": "source-reviewed"
              }
            }
          },
          "then": {
            "required": [
              "upstreamRevision",
              "evidenceFile",
              "archived",
              "pushedAt",
              "adoptionEvidence"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "sourceStatus": {
                "const": "official-document-fetched"
              }
            }
          },
          "then": {
            "required": [
              "sourceCheckedAt",
              "evidenceFile",
              "sourceEvidenceNote"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "stars": {
                "type": "integer"
              }
            }
          },
          "then": {
            "properties": {
              "starsCheckedAt": {
                "type": "string",
                "minLength": 1
              },
              "over10k": {
                "type": "boolean"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "stars": {
                "type": "null"
              }
            }
          },
          "then": {
            "properties": {
              "starsCheckedAt": {
                "type": "null"
              },
              "over10k": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "adapterStatus": {
                "const": "implemented-upstream-and-browser-tested"
              }
            }
          },
          "then": {
            "required": [
              "implementedAssurance",
              "implementedProtocol"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "productionReady": {
                "const": true
              }
            }
          },
          "then": {
            "required": [
              "approval"
            ],
            "properties": {
              "license": {
                "properties": {
                  "status": {
                    "const": "approved"
                  }
                },
                "type": "object"
              },
              "adapterStatus": {
                "not": {
                  "const": "planned"
                }
              }
            }
          }
        }
      ]
    }
  }
}
